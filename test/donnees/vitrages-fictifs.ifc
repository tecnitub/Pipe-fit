ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('vitrages-fictifs.ifc','2026-01-01T00:00:00',('Bureau ACME'),('ACME'),'Fichier écrit à la main','Test','');
FILE_SCHEMA(('IFC2X3'));
ENDSEC;
DATA;
/* Maquette fictive : deux bureaux au RDC, un mur sud commun (axe X du projet) et un mur est ; nord géographique tourné de
   45 degrés (TrueNorth = (-0,7071 ; 0,7071)) : la façade sud du projet (normale -Y) regarde le sud-ouest, la façade est (+X)
   le sud-est. Unités en mm. */
#1=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'Projet ACME vitrages',$,$,$,$,(#6),#5);
#2=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#3=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#4=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#5=IFCUNITASSIGNMENT((#2,#3,#4));
#6=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#7,#8);
#7=IFCAXIS2PLACEMENT3D(#9,$,$);
#8=IFCDIRECTION((-0.707106781187,0.707106781187));
#9=IFCCARTESIANPOINT((0.,0.,0.));
#10=IFCBUILDING('1kTvXnbbzCWw8lcMd1dR4o',$,'B\X2\00E2\X0\timent A',$,$,$,$,$,.ELEMENT.,$,$,$);
#11=IFCBUILDINGSTOREY('2HCQ3jD3n3xu9L2XWpwV0z',$,'RDC',$,$,#100,$,$,.ELEMENT.,0.);
#12=IFCRELAGGREGATES('3sy8tz4D1BqQuSr1lH8bY1',$,$,$,#10,(#11));
#100=IFCLOCALPLACEMENT($,#101);
#101=IFCAXIS2PLACEMENT3D(#9,$,$);
/* Espaces : origine du placement à l'intérieur de la pièce */
#20=IFCSPACE('1zJkLhK4f0kQ$5mZ5Gc8xE',$,'001',$,$,#110,$,'Bureau sud-ouest',.ELEMENT.,.INTERNAL.,$);
#21=IFCSPACE('1zJkLhK4f0kQ$5mZ5Gc8xF',$,'002',$,$,#115,$,'Bureau angle',.ELEMENT.,.INTERNAL.,$);
#22=IFCRELAGGREGATES('0ZsJFPzcf3xA1H$pWUq1Ab',$,$,$,#11,(#20,#21));
#110=IFCLOCALPLACEMENT(#100,#111);
#111=IFCAXIS2PLACEMENT3D(#112,$,$);
#112=IFCCARTESIANPOINT((2000.,2000.,0.));
#115=IFCLOCALPLACEMENT(#100,#116);
#116=IFCAXIS2PLACEMENT3D(#117,$,$);
#117=IFCCARTESIANPOINT((7000.,2000.,0.));
#23=IFCQUANTITYAREA('NetFloorArea',$,$,20.);
#24=IFCELEMENTQUANTITY('2b5Ij1VtL6chb1jqdfDXv1',$,'Qto_SpaceBaseQuantities',$,$,(#23));
#25=IFCRELDEFINESBYPROPERTIES('3pZ4G7aXz0Wfl1HmbNqUv1',$,$,$,(#20),#24);
#26=IFCQUANTITYAREA('NetFloorArea',$,$,25.);
#27=IFCELEMENTQUANTITY('2b5Ij1VtL6chb1jqdfDXv2',$,'Qto_SpaceBaseQuantities',$,$,(#26));
#28=IFCRELDEFINESBYPROPERTIES('3pZ4G7aXz0Wfl1HmbNqUv2',$,$,$,(#21),#27);
/* Murs : sud le long de l'axe X (y = 0), est le long de l'axe Y (x = 10 m, axe local X = +Y) */
#30=IFCWALLSTANDARDCASE('2O2Fr$t4X7Zf8NOew3FLOH',$,'Mur sud',$,$,#120,$,$);
#120=IFCLOCALPLACEMENT(#100,#121);
#121=IFCAXIS2PLACEMENT3D(#9,#122,#123);
#122=IFCDIRECTION((0.,0.,1.));
#123=IFCDIRECTION((1.,0.,0.));
#31=IFCWALLSTANDARDCASE('2O2Fr$t4X7Zf8NOew3FLOI',$,'Mur est',$,$,#125,$,$);
