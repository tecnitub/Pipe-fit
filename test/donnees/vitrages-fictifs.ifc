#69=IFCCARTESIANPOINT((5000.,0.));
#160=IFCCARTESIANPOINT((5000.,3000.));
#161=IFCCARTESIANPOINT((0.,3000.));
#70=IFCRELSPACEBOUNDARY('0kG3pQx7e2Xb9Nf4R1sTd2',$,$,$,#21,#30,#71,.PHYSICAL.,.EXTERNAL.);
#71=IFCCONNECTIONSURFACEGEOMETRY(#72,$);
#72=IFCCURVEBOUNDEDPLANE(#63,#64,());
#80=IFCRELSPACEBOUNDARY('0kG3pQx7e2Xb9Nf4R1sTd3',$,$,$,#21,#31,$,.PHYSICAL.,.EXTERNAL.);
#81=IFCRELCONTAINEDINSPATIALSTRUCTURE('0Q5mGrj1T2ePp7XQnHn5x1',$,$,$,(#30,#31,#40,#41,#42),#11);
