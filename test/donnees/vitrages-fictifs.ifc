/* Ouvertures et fenêtres */
#50=IFCOPENINGELEMENT('3yGQ9zZbD0ZgYtD2Y3wWm1',$,'Ouverture F1',$,$,#130,$,$);
#51=IFCOPENINGELEMENT('3yGQ9zZbD0ZgYtD2Y3wWm2',$,'Ouverture F2',$,$,#131,$,$);
#52=IFCOPENINGELEMENT('3yGQ9zZbD0ZgYtD2Y3wWm3',$,'Ouverture F3',$,$,#132,$,$);
