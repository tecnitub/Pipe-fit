#54=IFCRELVOIDSELEMENT('1Wq3Hk0Yb8xAQ6c7L0kQm2',$,$,$,#30,#51);
#55=IFCRELVOIDSELEMENT('1Wq3Hk0Yb8xAQ6c7L0kQm3',$,$,$,#31,#52);
#40=IFCWINDOW('0Lk2sYb7r1BvG4o5U2pZx1',$,'F1 fen\X2\00EA\X0\tre 200x150',$,$,#140,$,$,1500.,2000.);
#41=IFCWINDOW('0Lk2sYb7r1BvG4o5U2pZx2',$,'F2 baie',$,$,#141,$,$,$,$);
#42=IFCWINDOW('0Lk2sYb7r1BvG4o5U2pZx3',$,'F3 fen\X2\00EA\X0\tre 100x120',$,$,#142,$,$,1200.,1000.);
#140=IFCLOCALPLACEMENT(#130,#101);
#141=IFCLOCALPLACEMENT(#131,#101);
#142=IFCLOCALPLACEMENT(#132,#101);
#43=IFCQUANTITYAREA('Area',$,$,4.5);
#44=IFCELEMENTQUANTITY('2b5Ij1VtL6chb1jqdfDXv5',$,'Qto_WindowBaseQuantities',$,$,(#43));
#45=IFCRELDEFINESBYPROPERTIES('3pZ4G7aXz0Wfl1HmbNqUv5',$,$,$,(#41),#44);
#56=IFCRELFILLSELEMENT('2Zr6Jk9Ut0hB8Qx1Y2wFv1',$,$,$,#50,#40);
#57=IFCRELFILLSELEMENT('2Zr6Jk9Ut0hB8Qx1Y2wFv2',$,$,$,#51,#41);
#58=IFCRELFILLSELEMENT('2Zr6Jk9Ut0hB8Qx1Y2wFv3',$,$,$,#52,#42);
/* Limites d'espace : façade sud des deux bureaux (plan dans le repère de l'espace, normale vers l'extérieur), mur est sans géométrie */
#60=IFCRELSPACEBOUNDARY('0kG3pQx7e2Xb9Nf4R1sTd1',$,$,$,#20,#30,#61,.PHYSICAL.,.EXTERNAL.);
#61=IFCCONNECTIONSURFACEGEOMETRY(#62,$);
#62=IFCCURVEBOUNDEDPLANE(#63,#64,());
