{
  "name": "pipefit-crm",
  "version": "1.3.6",
  "private": true,
  "description": "CRM multi-utilisateurs pour entreprise de tuyauterie industrielle : contacts, devis, facturation, livraison, planning, heures, rentabilité et REX",
  "main": "server/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "start:doe": "node --disable-warning=ExperimentalWarning doe/server.js",
    "start:etudes": "node --disable-warning=ExperimentalWarning etudes/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test test/e2e/*.e2e.js",
    "verifier-pack": "node --disable-warning=ExperimentalWarning deploy/verifier-pack.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
