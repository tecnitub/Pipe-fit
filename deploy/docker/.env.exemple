# Copier en .env puis adapter. Les noms DNS doivent pointer vers ce serveur (ports 80 et 443 ouverts).
DOMAINE=crm.votre-domaine.fr
DOMAINE_DOE=doe.votre-domaine.fr
DOMAINE_ETUDES=etudes.votre-domaine.fr
# Dossiers de l'hôte (disque local ou NAS monté) : documents synchronisés + pièces jointes, sauvegardes de la base
DOSSIER_DOCUMENTS=/srv/pipefit/Documents
DOSSIER_SAUVEGARDES=/mnt/nas/pipefit/Sauvegardes
# Mot de passe du compte « admin » créé au premier démarrage (10 caractères au moins) ; à changer ensuite dans l'appli
ADMIN_PASSWORD=
