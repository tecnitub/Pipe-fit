# Réglages de Pipe-Fit CRM et de l'application DOE (/etc/pipefit/pipefit.env).
# Après modification : sudo systemctl restart pipefit pipefit-doe

# Port et base
PORT=3000
DB_FILE=/var/lib/pipefit/pipefit.db
NODE_ENV=production
# Base vide au premier démarrage (pas de données de démonstration)
SEED_DEMO=0

# Dossiers (local ou NAS monté, ex. /mnt/nas/pipefit/...) : le compte « pipefit » doit pouvoir y écrire
DOCUMENTS_DIR=/srv/pipefit/Documents
PJ_DIR=/srv/pipefit/Documents/Pièces jointes
BACKUP_DIR=/srv/pipefit/Sauvegardes

# HTTPS — soit un reverse proxy (Caddy, voir Caddyfile.exemple) devant le port 3000 : laisser vide ;
# soit le certificat dans /var/lib/pipefit/tls (cert.pem + key.pem) avec PORT=443 et HTTP_REDIRECT_PORT=80
#HTTP_REDIRECT_PORT=80
#TLS_PASSPHRASE=
# Reverse proxy installé sur une autre machine
#TRUST_PROXY=1

# Application DOE
DOE_PORT=3100
DOE_DB_FILE=/var/lib/pipefit/doe/doe.db
PIPEFIT_URL=http://localhost:3000
#PIPEFIT_PUBLIC_URL=https://crm.votre-domaine.fr
