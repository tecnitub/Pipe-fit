<Project Sdk="Microsoft.NET.Sdk">
  <!-- Données de la démonstration (sans Revit) : dotnet run, project revit/demo, argument = fichier JSON de sortie -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
