<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Complément Revit « Pipe-Fit Isométries ». Une compilation par version de Revit :
      dotnet build -c Release -p:RevitVersion=2025
    Revit 2023-2024 : .NET Framework 4.8 ; Revit 2025-2026 : .NET 8 ; Revit 2027 : .NET 10.
    Les références de l'API Revit viennent des paquets NuGet Nice3point.Revit.Api (assemblages de référence).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2025' And '$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <AssemblyName>PipeFit.Isometries</AssemblyName>
    <RootNamespace>PipeFit.Isometries</RootNamespace>
    <Version>2.8.0</Version>
    <Company>TECNITUB</Company>
    <Product>Pipe-Fit Isométries</Product>
    <Description>Isométries de fabrication par numéro de spool pour Revit</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>
</Project>
