<Project>
  <!-- Dossiers obj séparés par version de Revit (restauration NuGet différente pour chaque version) -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <BaseIntermediateOutputPath>obj\$(RevitVersion)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
